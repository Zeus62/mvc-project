@{
    ViewData["Title"] = "Home";
}

@if (User.Identity != null && User.Identity.IsAuthenticated)
{
    var username = ViewBag.Username as string;
    var isAdmin = (bool)ViewBag.IsAdmin;

    <div class="dashboard">
        <div class="dashboard-welcome" style="margin-bottom: 2rem;">
            <h1>Welcome back, @username! 👋</h1>
            <p>
                @if (isAdmin)
                {
                    <span>Admin Access: You have full access to manage all tasks.</span>
                }
                else
                {
                    <span>User Access: You can view and create your own tasks.</span>
                }
            </p>
        </div>

        <div class="quick-actions" style="margin-top: 2rem;">
            <h3>Quick Actions</h3>
            <div style="display: flex; gap: 1rem; margin-top: 1rem;">
                <a asp-controller="Tasks" asp-action="Index" class="btn btn-primary">View Tasks</a>
                <a asp-controller="Tasks" asp-action="Create" class="btn btn-outline">New Task</a>
                <a asp-controller="Account" asp-action="Logout" class="btn btn-outline">Logout</a>
            </div>
        </div>
    </div>
}
else
{
    <div class="landing">
        <div class="landing-content">
            <div class="landing-badge">Task Management</div>
            <h1>Welcome to <span class="highlight">TaskBoard</span></h1>
            <p class="landing-subtitle">
                A simple and elegant task management tool. Organize your work, track progress, and get things done.
            </p>
            <div class="landing-actions">
                <a asp-controller="Account" asp-action="Login" class="btn btn-primary btn-lg">
                    <span>Sign In</span>
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" viewBox="0 0 16 16">
                        <path fill-rule="evenodd" d="M1 8a.5.5 0 0 1 .5-.5h11.793l-3.147-3.146a.5.5 0 0 1 .708-.708l4 4a.5.5 0 0 1 0 .708l-4 4a.5.5 0 0 1-.708-.708L13.293 8.5H1.5A.5.5 0 0 1 1 8"/>
                    </svg>
                </a>
                <a asp-controller="Account" asp-action="Register" class="btn btn-outline btn-lg">
                    Create Account
                </a>
            </div>
        </div>

        <div class="features-grid">
            <div class="feature-card">
                <div class="feature-icon">📋</div>
                <h3>Task Management</h3>
                <p>Create, organize, and track your tasks with ease.</p>
            </div>
            <div class="feature-card">
                <div class="feature-icon">🔒</div>
                <h3>Role-Based Access</h3>
                <p>Admin and User roles with appropriate permissions.</p>
            </div>
            <div class="feature-card">
                <div class="feature-icon">⚡</div>
                <h3>Fast & Simple</h3>
                <p>Clean interface designed for productivity.</p>
            </div>
        </div>
    </div>
}
