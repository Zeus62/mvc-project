@model mvc_project.Models.AppUser
@{
    ViewData["Title"] = "Create User";
}

<div class="form-page">
    <div class="form-card">
        <div class="form-card-header">
            <h1>Create User</h1>
            <p>Add a new account to the system.</p>
        </div>

        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

            <div class="form-group">
                <label asp-for="Username" class="form-label">Username</label>
                <input asp-for="Username" class="form-input" required minlength="3" maxlength="20" />
                <span asp-validation-for="Username" class="field-validation"></span>
            </div>

            <div class="form-group">
                <label asp-for="Password" class="form-label">Password</label>
                <input asp-for="Password" type="password" class="form-input" required minlength="6" />
                <span asp-validation-for="Password" class="field-validation"></span>
            </div>

            <div class="form-actions">
                <a asp-action="Index" class="btn btn-outline">Cancel</a>
                <button type="submit" class="btn btn-primary">Create User</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
