@model mvc_project.Models.TaskItem
@{
    ViewData["Title"] = "Create Task";
}

<div class="form-page">
    <div class="form-card">
        <div class="form-card-header">
            <h1>
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" viewBox="0 0 16 16">
                    <path d="M8 4a.5.5 0 0 1 .5.5v3h3a.5.5 0 0 1 0 1h-3v3a.5.5 0 0 1-1 0v-3h-3a.5.5 0 0 1 0-1h3v-3A.5.5 0 0 1 8 4"/>
                </svg>
                Create New Task
            </h1>
            <p>Fill in the details below to create a new task</p>
        </div>

        <form asp-action="Create" method="post" id="createTaskForm" novalidate>
            <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

            <div class="form-group">
                <label asp-for="Title" class="form-label">Task Title *</label>
                <input asp-for="Title" class="form-input" placeholder="Enter a descriptive title" id="taskTitle" />
                <span asp-validation-for="Title" class="field-validation"></span>
            </div>

            <div class="form-group">
                <label asp-for="Description" class="form-label">Description *</label>
                <textarea asp-for="Description" class="form-input form-textarea" placeholder="Describe what needs to be done..." rows="4" id="taskDescription"></textarea>
                <span asp-validation-for="Description" class="field-validation"></span>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label asp-for="Priority" class="form-label">Priority</label>
                    <select asp-for="Priority" class="form-input" id="taskPriority">
                        <option value="Low">🟢 Low</option>
                        <option value="Medium" selected>🟡 Medium</option>
                        <option value="High">🔴 High</option>
                    </select>
                </div>

                <div class="form-group">
                    <label asp-for="Status" class="form-label">Status</label>
                    <select asp-for="Status" class="form-input" id="taskStatus">
                        <option value="Pending">Pending</option>
                        <option value="In Progress">In Progress</option>
                        <option value="Done">Done</option>
                    </select>
                </div>
            </div>

            <div class="form-actions">
                <a asp-action="Index" class="btn btn-secondary">Cancel</a>
                <button type="submit" class="btn btn-primary">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 16 16">
                        <path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14m0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16"/>
                        <path d="m10.97 4.97-.02.022-3.473 4.425-2.093-2.094a.75.75 0 0 0-1.06 1.06L6.97 11.03a.75.75 0 0 0 1.079-.02l3.992-4.99a.75.75 0 0 0-1.071-1.05"/>
                    </svg>
                    Create Task
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
    <script src="~/js/validation.js"></script>
}
