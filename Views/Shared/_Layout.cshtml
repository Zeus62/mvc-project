<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="TaskBoard - A simple task management application" />
    <title>@ViewData["Title"] - TaskBoard</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/dark.css" asp-append-version="true" />
</head>
<body>
    <nav class="navbar">
        <div class="nav-container">
            <a class="nav-brand" asp-controller="Home" asp-action="Index">
                TaskBoard
            </a>
            <div class="nav-links">
                <button id="themeToggleBtn" class="theme-toggle-btn" onclick="toggleTheme()" title="Switch Theme">🌙</button>
                @if (User.Identity != null && User.Identity.IsAuthenticated)
                {
                    <a asp-controller="Home" asp-action="Index" class="nav-link">Home</a>
                    <a asp-controller="Tasks" asp-action="Index" class="nav-link">Tasks</a>
                    @if (User.IsInRole("Admin"))
                    {
                        <a asp-controller="Users" asp-action="Index" class="nav-link nav-link-admin">Manage Users</a>
                    }
                    <div class="nav-user">
                        <span class="nav-username">
                            @User.Identity?.Name
                            @if (User.IsInRole("Admin"))
                            {
                                <span class="nav-role-badge">Admin</span>
                            }
                        </span>
                        <a asp-controller="Account" asp-action="Logout" class="btn btn-sm btn-outline">Logout</a>
                    </div>
                }
                else
                {
                    <a asp-controller="Account" asp-action="Login" class="btn btn-sm btn-outline">Sign In</a>
                    <a asp-controller="Account" asp-action="Register" class="btn btn-sm btn-primary">Register</a>
                }
            </div>
        </div>
    </nav>

    <main class="main-content">
        @RenderBody()
    </main>

    <footer class="footer">
        <div class="footer-content">
            <p>&copy; 2026 TaskBoard — Built with ASP.NET Core MVC</p>
        </div>
    </footer>

    <script src="~/js/theme.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
