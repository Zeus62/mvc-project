<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="TaskBoard - A simple task management application" />
    <title>@ViewData["Title"] - TaskBoard</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <nav class="navbar" style="border-bottom: 1px solid #ddd; padding: 1rem;">
        <div class="nav-container" style="display: flex; justify-content: space-between; align-items: center;">
            <a class="nav-brand" asp-controller="Home" asp-action="Index" style="font-weight: bold; font-size: 1.2rem; text-decoration: none; color: #333;">
                TaskBoard
            </a>
            <div class="nav-links" style="display: flex; gap: 1rem; align-items: center;">
                @if (User.Identity != null && User.Identity.IsAuthenticated)
                {
                    <a asp-controller="Home" asp-action="Index" class="nav-link" style="text-decoration: none; color: #555;">Home</a>
                    <a asp-controller="Tasks" asp-action="Index" class="nav-link" style="text-decoration: none; color: #555;">Tasks</a>
                    @if (User.IsInRole("Admin"))
                    {
                        <a asp-controller="Users" asp-action="Index" class="nav-link" style="text-decoration: none; color: #0056b3; font-weight: bold;">Manage Users</a>
                    }
                    <div class="nav-user" style="display: flex; gap: 1rem; align-items: center; margin-left: 1rem;">
                        <span class="nav-username" style="font-weight: 500; color: #333;">
                            @User.Identity?.Name
                            @if (User.IsInRole("Admin"))
                            {
                                <span class="nav-role-badge" style="font-size: 0.8rem; background: #eee; padding: 0.2rem 0.5rem; border-radius: 4px;">Admin</span>
                            }
                        </span>
                        <a asp-controller="Account" asp-action="Logout" class="btn btn-outline" style="text-decoration: none; padding: 0.3rem 0.6rem; border: 1px solid #ccc; border-radius: 4px; color: #333;">Logout</a>
                    </div>
                }
                else
                {
                    <a asp-controller="Account" asp-action="Login" class="btn btn-outline" style="text-decoration: none; padding: 0.3rem 0.6rem; border: 1px solid #ccc; border-radius: 4px; color: #333;">Sign In</a>
                    <a asp-controller="Account" asp-action="Register" class="btn btn-primary" style="text-decoration: none; padding: 0.3rem 0.6rem; border: 1px solid #007bff; background: #007bff; color: #fff; border-radius: 4px;">Register</a>
                }
            </div>
        </div>
    </nav>

    <main class="main-content">
        @RenderBody()
    </main>

    <footer class="footer">
        <div class="footer-content">
            <p>&copy; 2026 TaskBoard — Built with ASP.NET Core MVC</p>
        </div>
    </footer>

    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
